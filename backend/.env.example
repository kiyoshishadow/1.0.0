NODE_ENV=development
PORT=3001
# En producción use una clave larga y aleatoria; nunca la incluya en Git.
SESSION_SECRET=cambie-esta-clave-por-una-secreta-y-larga
# Duración de la sesión en milisegundos (8 horas).
SESSION_TTL_MS=28800000
# Opcional. Orígenes externos separados por coma. Déjelo vacío si frontend y API comparten host.
CORS_ORIGIN=
# Configure estas variables según su entorno PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=control_impresiones
DB_USER=postgres
DB_PASSWORD=
